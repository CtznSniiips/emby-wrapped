# Emby Wrapped Environment Configuration
# Copy to .env and fill in values

# Required: Emby server URL (include protocol and port)
EMBY_URL=http://your-emby-server:8096

# Required: Emby Admin API key
EMBY_API_KEY=your_api_key_here

# Optional: TMDB API key for enhanced poster images
# Get a free API key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=


# Optional: Seerr/Overseerr/Jellyseerr base URL for community request stats card
# Example: http://your-seer-server:5055
SEERR_URL=

# Optional: Seerr/Overseerr/Jellyseerr API key (required if SEER_URL is set)
SEERR_API_KEY=

# Optional: Tracearr base URL + public API key (trr_pub_*)
# When both are set, playback history is sourced from Tracearr instead of Emby Playback Reporting
TRACEARR_URL=
TRACEARR_API_KEY=
# Optional: Map old Tracearr usernames to current Emby usernames (for renamed accounts)
# Format: oldname1:newname1,oldname2:newname2 (case-insensitive)
TRACEARR_USERNAME_ALIASES=
# Optional: How many Tracearr history pages to fetch concurrently per request.
# Lower this if your Tracearr instance drops connections (ECONNRESET / socket
# errors in the logs) under sustained load, e.g. during cache warmup.
TRACEARR_PAGE_CONCURRENCY=4

# Optional: Public URL for share links (defaults to request origin)
PUBLIC_URL=https://wrapped.example.com

# Optional: Cache TTL in seconds (default: 86400 = 24 hours)
CACHE_TTL=86400

# Optional: Directory for the per-user stats cache (one JSON file per user/period).
# Point this at a mounted volume (e.g. /app/cache) so the cache survives
# container restarts. If unset, defaults to /tmp/stats-cache in production
# (wiped on every restart) or .cache/stats in dev.
STATS_CACHE_DIR=/app/cache

# Optional: Pre-generate (and keep warm) the server-wide and per-user caches
# for every completed year/month at startup, instead of computing them
# lazily on first request. Default: true.
CACHE_WARMUP_ENABLED=true

# Optional: How many users' stats to warm at once during cache warmup.
# Higher = faster warmup but more concurrent load on Emby/Tracearr/TMDB.
# Each user's warmup is itself a burst of several requests, so keep this low
# for a lightweight self-hosted Tracearr/Emby instance. Default: 1
CACHE_WARMUP_CONCURRENCY=1

# Optional: Milliseconds to wait after each user's warmup before starting the
# next (per concurrent slot). Keeps warmup from reading as sustained hammering
# to a lightweight Tracearr/Emby instance even at concurrency 1. Set to 0 to
# disable. Default: 1000
CACHE_WARMUP_DELAY_MS=1000

# Optional: How often (in minutes) to check for a newly-completed period
# (month/year rollover) and refresh the current, in-progress period so its
# cache never goes cold under a real user. Default: 15
CACHE_REFRESH_INTERVAL_MINUTES=15

# Optional: Analytics script (e.g. Umami, Plausible)
# Example: <script defer src="https://cloud.umami.is/script.js" data-website-id="your-id"></script>
ANALYTICS_SCRIPT=

# Optional: User ID for filtering media library items
# Use this to filter out NSFW content by specifying a restricted user's ID
# Only items accessible to this user will be displayed in stats
# Leave empty to use each user's own library permissions
FILTER_USER_ID=

# Optional: Application listen port (default: 3003)
PORT=3003
